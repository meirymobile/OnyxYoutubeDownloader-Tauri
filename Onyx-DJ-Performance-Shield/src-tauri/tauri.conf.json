{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onyx DJ Performance Shield",
  "version": "1.0.0",
  "identifier": "com.meir.onyx-dj-performance-shield",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Onyx DJ Performance Shield — By DJ Shazz",
        "width": 980,
        "height": 760,
        "minWidth": 800,
        "minHeight": 620,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
