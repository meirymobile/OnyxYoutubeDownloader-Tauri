{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnyxYoutubeDownloader",
  "version": "0.1.0",
  "identifier": "com.meir.onyxyoutubedownloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Onyx Youtube Downloader",
        "width": 1000,
        "height": 700,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [
      "bin/backend_server"
    ],
    "macOS": {
      "frameworks": [
        "djay_reader.dylib"
      ]
    }
  }
}